<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<RootNamespace>Toart.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
		<AssemblyVersion>0.0.2</AssemblyVersion>
		<AssemblyFileVersion>0.0.2</AssemblyFileVersion>
		<Version>0.0.2</Version>
		<NeutralLanguage>en</NeutralLanguage>
		<!--Version of C# to use -->
		<PackageId>Toast.Maui</PackageId>
		<LangVersion>latest</LangVersion>
		<Authors>NamCkiku</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>Toast.Maui plug-in for .NET MAUI</Description>
		<PackageTags>Toast.Maui .NET MAUI</PackageTags>
		<PackageReleaseNotes>Toast.Maui with .NET MAUI</PackageReleaseNotes>
		<Copyright>Copyright 2026</Copyright>
		<PackOnBuild>true</PackOnBuild>
		<SynchReleaseVersion>false</SynchReleaseVersion>
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
		<Configurations>Release;Debug</Configurations>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.51" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.51" />
	</ItemGroup>

</Project>
